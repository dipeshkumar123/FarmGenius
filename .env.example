# =================================================================
# FarmGenius — Environment Variables
# Copy this file to .env and fill in the values
# =================================================================

# --------------- Database ---------------
# Neon PostgreSQL connection string (from Vercel → Storage → Neon)
# Format: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=

# --------------- API Keys ---------------
# DeepSeek API key for LLM fallback
DEEPSEEK_API_KEY=

# OpenWeatherMap API key
WEATHER_API_KEY=

# --------------- Server (local dev) ---------------
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=False
